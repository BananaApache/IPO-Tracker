# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Secrets -- .env.example is committed instead
.env

# Node / Next.js
node_modules/
.next/
# Anchored: an unanchored `out/` matches any directory named `out` at any
# depth, which silently swallowed thesis/data/out/ (the study's results).
/frontend/out/
/archive/frontend/out/

# Local backup of the pre-FastAPI Django/Celery project. Kept on disk for
# convenience only -- the same code is in git history at 81691fc and earlier.
archive/

# OS
.DS_Store

# Underpricing study: derived and re-downloadable data.
#
# cache/ is ~3,960 per-firm API responses (15M) -- regenerated by
# build_panel.py, and committing it would bury every future diff.
# raw/ is 41M of public source files, 40M of which is SEC's
# cik-lookup-data.txt -- one curl away, no reason to version it. (The rest of
# research/data/raw/ IS committed; this subtree is the exception, on size.)
#
# research/data/underpricing/out/ is deliberately NOT ignored: it holds the
# results, the analysis panel the notebooks read, and review_verdicts.csv --
# 28 hand-made adjudications that no amount of re-running can reproduce.
research/data/underpricing/cache/
research/data/underpricing/raw/
