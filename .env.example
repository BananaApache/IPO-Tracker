# Copy to .env and adjust. .env is gitignored; this file is committed.
#
# These same variables configure both the postgres container (docker compose
# passes them to the image) and the app (pydantic-settings reads them in
# backend/config.py). compose overrides POSTGRES_HOST to `db` for the
# containers, so the value here is the one the *host* uses.

POSTGRES_DB=ipo
POSTGRES_USER=ipo
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connections opened at startup / ceiling. Keep max well under Postgres's
# max_connections (default 100), since the worker process gets its own pool.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Salt for hashing social-media usernames (mentions.author_hash). Raw usernames
# are never stored. Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
# Changing this orphans every existing hash -- set it once per deployment.
MENTION_HASH_SALT=generate_a_random_value

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:3000"]

# SEC EDGAR requires a descriptive User-Agent carrying a real contact email;
# requests without one are rejected with 403. Put YOUR address here.
SEC_USER_AGENT=YourProjectName/0.1 (you@example.com)

# Market data (Polygon). Free tier: 5 requests/minute.
# Create at https://polygon.io/dashboard/api-keys
MARKET_DATA_API_KEY=your_polygon_key

# News (Finnhub). Free tier: 60 calls/minute.
# Create at https://finnhub.io/dashboard
NEWS_API_KEY=your_finnhub_key

# Reddit, via OAuth. Leave empty and the adapter is not registered at all --
# no request to reddit.com is made. Create a "script" app at
# https://www.reddit.com/prefs/apps to get the id and secret.
# Unauthenticated reddit.com/*.json endpoints return 403 and are not an option.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=YourProject/1.0 (by /u/your_username)
