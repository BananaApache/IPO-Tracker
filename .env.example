# Copy to .env and adjust. .env is gitignored; this file is committed.
#
# These same variables configure both the postgres container (docker compose
# passes them to the image) and the app (pydantic-settings reads them in
# backend/config.py). compose overrides POSTGRES_HOST to `db` for the
# containers, so the value here is the one the *host* uses.

POSTGRES_DB=ipo
POSTGRES_USER=ipo
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connections opened at startup / ceiling. Keep max well under Postgres's
# max_connections (default 100), since the worker process gets its own pool.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
